-- Ordinary source data, classes, and functions.
-- Effect, print, pureEffect, and bindEffect are runtime primitives.
data Option a = None | Some a;
data Result a e = Ok a | Err e;
data List a = Nil | Cons a (List a);

class Functor (f : Type -> Type) where {
  map : forall a b. (a -> b) -> f a -> f b;
}

instance Functor Option where {
  map f option = case option of {
    None -> None;
    Some value -> Some (f value);
  };
}

instance Functor List where {
  map f list =
    let rec loop xs = case xs of {
      Nil -> Nil;
      Cons value rest -> Cons (f value) (loop rest);
    } in loop list;
}

class Monad (m : Type -> Type) where {
  pure : forall a. a -> m a;
  bind : forall a b. m a -> (a -> m b) -> m b;
}

instance Monad Option where {
  pure value = Some value;
  bind option next = case option of {
    None -> None;
    Some value -> next value;
  };
}

instance Monad Effect where {
  pure value = pureEffect value;
  bind action next = bindEffect action next;
}

id x = x;
const x y = x;
compose f g x = f (g x);

mapOption f option = case option of {
  None -> None;
  Some value -> Some (f value);
};
withDefault fallback option = case option of {
  None -> fallback;
  Some value -> value;
};
mapResult f result = case result of {
  Ok value -> Ok (f value);
  Err error -> Err error;
};
andThen f result = case result of {
  Ok value -> f value;
  Err error -> Err error;
};

rec mapList f list = case list of {
  Nil -> Nil;
  Cons value rest -> Cons (f value) (mapList f rest);
};
rec foldList f initial list = case list of {
  Nil -> initial;
  Cons value rest -> foldList f (f initial value) rest;
};
head list = case list of {
  Nil -> None;
  Cons value _ -> Some value;
};
length list = foldList (\count ignored -> count + 1) 0 list;
rec append left right = case left of {
  Nil -> right;
  Cons value rest -> Cons value (append rest right);
};
rec range start end =
  if start > end then Nil else Cons start (range (start + 1) end);

(macro pipe3 [value first second third]
  (third (second (first value))))

(macro interlock [condition fallback action]
  (if condition action fallback))

(macro instrument [label action]
  (let [result action]
    (extend result {telemetry {event label recorded true}})))

(macro burn [ship amount]
  (let [craft ship
        fuel amount]
    (update craft fuel (- (. craft fuel) fuel))))

(macro ignite [ship]
  (let [craft ship]
    (extend
      (update craft engine
        {mode "burning" thrust (* (. craft engine) 100)})
      {ignited true})))

(macro navigate [ship target]
  (let [craft ship
        destination target]
    (extend craft
      {navigation
        {destination (. destination name)
         distance (. destination distance)
         locked true}})))

(macro deploy [ship]
  (let [craft ship]
    (extend
      (update craft payload
        {name (. (. craft payload) name)
         deployed true})
      {signal (concat "ONLINE: " (. craft name))})))

(def docked
  {name "Nightjar"
   fuel 90
   engine 8
   payload {name "Aurora Observatory" mass 1200}
   crew {pilot "Ada" navigator "Grace"}
   secret "the stars are listening"})

(def destination {name "Europa" distance 628})

(def lightEngines (fn [ship] (ignite (burn ship 25))))
(def setCourse (fn [ship] (navigate ship destination)))
(def releaseObservatory (fn [ship] (deploy ship)))

(def mission
  (instrument "first-light"
    (pipe3 docked lightEngines setCourse releaseObservatory)))

(def scout
  (ignite
    {name "Firefly"
     fuel 12
     engine 2
     payload {name "Beacon"}
     autonomous true}))

(def clearance
  (interlock (> (. docked fuel) 50)
    {approved false message "Launch cancelled"}
    {approved true message (. mission signal)}))

(def silentAbort
  (interlock false
    {status "safely grounded"}
    (let [notification (print "THIS MUST NEVER BE PRINTED")]
      {status "unsafe launch"})))

(def shadowTest
  (let [craft "not a spacecraft"
        fuel 999
        concat (fn [left right] "hijacked")]
    {callerCraft craft
     callerFuel fuel
     remaining (. (burn docked 5) fuel)
     signal (. (deploy docked) signal)}))

{mission mission
 clearance clearance
 abort silentAbort
 scoutAutonomous (. scout autonomous)
 scoutThrust (. (. scout engine) thrust)
 originalEngine (. docked engine)
 originalPayloadMass (. (. docked payload) mass)
 preservedSecret (. mission secret)
 hygiene shadowTest}

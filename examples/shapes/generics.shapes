(def identity
  (fn [(value 'a)] value))

(def compose
  (fn [(outer (-> 'b 'c)) (inner (-> 'a 'b)) (value 'a)]
    (outer (inner value))))

(def mapValue
  (fn [(transform (-> 'a 'b)) (packet {value 'a ..r})]
    (update packet value (transform (. packet value)))))

(def zipWith
  (fn [(combine (-> 'a 'b 'c))
       (left {value 'a ..left})
       (right {value 'b ..right})]
    {value (combine (. left value) (. right value))
     left left
     right right}))

(def swap
  (fn [(pair {first 'a second 'b ..r})]
    (let [first (. pair first)
          second (. pair second)]
      (update (update pair first second) second first))))

(def choose
  (fn [(condition boolean) (left 'a) (right 'a)]
    (if condition left right)))

(def twice
  (fn [(transform (-> 'a 'a)) (value 'a)]
    (transform (transform value))))

(def readTemperature
  (fn [(sensor {kelvin number ..r})]
    (- (. sensor kelvin) 273.15)))

(def classify
  (fn [(temperature number)]
    (if (> temperature 30) "hot" "nominal")))

(def classifySensor (compose classify readTemperature))

(def incoming
  {value {kelvin 310 serial "sensor-07"}
   channel "reactor"
   sequence 42})

(def classified (mapValue classifySensor incoming))

(def greeting
  (mapValue
    (fn [(name string)] (concat "Welcome aboard, " name))
    {value "Ada" encrypted true}))

(def combined
  (zipWith
    (fn [(state string) (ready boolean)]
      {state state ready ready})
    classified
    {value true source "flight-control"}))

(def coordinates
  (swap {first "Europa" second 628 units "million km"}))

{numberIdentity (identity 42)
 stringIdentity (identity "Shapes")
 classified classified
 originalSensor (. incoming value)
 greeting greeting
 combined combined
 coordinates coordinates
 selected (choose true "launch" "hold")
 boosted (twice (fn [(fuel number)] (+ fuel 5)) 80)}

{
  "name": "langkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Small cooperating tools for language experiments",
  "exports": {
    ".": "./src/index.ts",
    "./parse": "./src/parse.ts",
    "./ir": "./src/ir.ts",
    "./ir/check": "./src/ir/check.ts",
    "./python": "./src/python.ts",
    "./python/*": "./src/python/*.ts",
    "./javascript": "./src/javascript.ts",
    "./operations/*": "./src/operations/*.ts",
    "./javascript/*": "./src/javascript/*.ts",
    "./inference": "./src/inference.ts",
    "./types/*": "./src/types/*.ts",
    "./syntax": "./src/syntax.ts",
    "./adapters/ts-macros": "./src/adapters/ts-macros.ts",
    "./modules": "./src/modules.ts",
    "./modules/imports": "./src/modules/imports.ts",
    "./analysis": "./src/analysis.ts",
    "./lsp": "./src/lsp.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "type:contracts": "node tools/type-contracts.ts",
    "editor:check": "node tools/editor-check.ts",
    "editor:update": "node tools/editor-check.ts --update",
    "type:profile": "node tools/type-profile.ts",
    "macros:integration": "node tools/macros-integration.ts",
    "toy": "node examples/toy/toy.ts",
    "toy:lsp": "node examples/toy/toy-lsp.ts --stdio",
    "hm": "node examples/hm/hm.ts",
    "hm:lsp": "node examples/hm/hm-lsp.ts --stdio",
    "rows": "node examples/rows/rows.ts",
    "rows:lsp": "node examples/rows/rows-lsp.ts --stdio",
    "advanced": "node examples/advanced/advanced.ts",
    "advanced:lsp": "node examples/advanced/advanced-lsp.ts --stdio",
    "strict": "node examples/strict/strict.ts",
    "strict:lsp": "node examples/strict/strict-lsp.ts --stdio",
    "ur": "node examples/ur/ur.ts",
    "ur:lsp": "node examples/ur/ur-lsp.ts --stdio",
    "schema": "node examples/schema/schema.ts",
    "schema:lsp": "node examples/schema/schema-lsp.ts --stdio",
    "shapes": "node examples/shapes/shapes.ts",
    "shapes:lsp": "node examples/shapes/shapes-lsp.ts --stdio"
  },
  "dependencies": {
    "parserator": "0.3.0",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.2"
  }
}

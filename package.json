{
  "name": "langkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Small cooperating tools for language experiments",
  "exports": {
    ".": "./src/index.ts",
    "./parse": "./src/parse.ts",
    "./ir": "./src/ir.ts",
    "./javascript": "./src/javascript.ts",
    "./analysis": "./src/analysis.ts",
    "./lsp": "./src/lsp.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "toy": "node examples/toy/toy-run.ts",
    "toy:lsp": "node examples/toy/toy-lsp.ts --stdio",
    "hm": "node examples/hm/hm-run.ts",
    "hm:lsp": "node examples/hm/hm-lsp.ts --stdio",
    "rows": "node examples/rows/rows-run.ts",
    "rows:lsp": "node examples/rows/rows-lsp.ts --stdio",
    "advanced": "node examples/advanced/advanced-run.ts",
    "advanced:lsp": "node examples/advanced/advanced-lsp.ts --stdio",
    "strict": "node examples/strict/strict-run.ts",
    "strict:lsp": "node examples/strict/strict-lsp.ts --stdio",
    "ur": "node examples/ur/ur-run.ts",
    "ur:lsp": "node examples/ur/ur-lsp.ts --stdio",
    "schema": "node examples/schema/schema-run.ts",
    "schema:lsp": "node examples/schema/schema-lsp.ts --stdio"
  },
  "dependencies": {
    "parserator": "0.3.0",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.2"
  }
}
